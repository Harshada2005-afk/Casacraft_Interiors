# ---------------------------------------------------------------
# CasaCraft Interiors API – copy this file to ".env" and fill it in.
# Never commit your real .env file.
# ---------------------------------------------------------------

# Port the API listens on
PORT=5000

# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/casacraft
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/casacraft
MONGODB_URI=

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Address of the React frontend (allowed by CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173

# ---------- Optional ----------
# How long a login token stays valid
JWT_EXPIRES_IN=7d
# development | production
NODE_ENV=development

# Development seed accounts (used only by "npm run seed").
# If a password is left empty, a random one is generated and printed once.
SEED_ADMIN_EMAIL=admin@casacraft.local
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@casacraft.local
SEED_CUSTOMER_PASSWORD=
